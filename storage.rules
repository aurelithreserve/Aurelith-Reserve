rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated user profile photos stored at /users/{userId}/profile/{fileName}
    match /users/{userId}/profile/{fileName} {
      // Allow read for image display
      allow read: if true;

      // Only the authenticated account owner can upload or overwrite their own photo
      // Enforce file size limit of 10MB and image MIME type
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Only the authenticated account owner can delete their profile photo
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Default deny all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
