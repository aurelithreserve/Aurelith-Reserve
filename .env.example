# PORT: Server port (default: 3000)
PORT=3000

# NODE_ENV: Runtime environment (development | production)
NODE_ENV=development

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Client Configuration (matching firebase-applet-config.json)
VITE_FIREBASE_API_KEY="AIzaSyAe-7ztYt5p49mUKO-pKt6niGRSYog4o-M"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0464359010.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0464359010"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0464359010.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="452384315066"
VITE_FIREBASE_APP_ID="1:452384315066:web:b487bd458ab495d7215483"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-aurelithreserve1-671ec318-7ad2-4d02-a368-50ab6882fcbd"

# Optional Backend API URL (for production hosting on Netlify)
# If your backend API is deployed on an external server (e.g. Cloud Run, Render, VPS),
# set VITE_API_URL to your backend host (e.g. "https://api.yourdomain.com").
# When unset, API requests use relative path "/api/*".
VITE_API_URL=""
