# PORT: Server port (default: 3000)
PORT=3000

# NODE_ENV: Runtime environment (development | production)
NODE_ENV=development

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# Firebase Client Configuration (matching firebase-applet-config.json)
# Note: In Vite, src/lib/firebase.ts automatically falls back to firebase-applet-config.json
# if these environment variables are unset.
VITE_FIREBASE_API_KEY="AIzaSyDquaNl2jh8WJq04LbcxPSRp-CdqGaPlIc"
VITE_FIREBASE_AUTH_DOMAIN="ai-studio-applet-webapp-d4e32.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ai-studio-applet-webapp-d4e32"
VITE_FIREBASE_STORAGE_BUCKET="ai-studio-applet-webapp-d4e32.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="604611880265"
VITE_FIREBASE_APP_ID="1:604611880265:web:2b01e27429a69513f4e698"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-remixaurelithres-b9df85c9-7840-4507-ae54-bad112fb0dd9"

# Architecture note:
# Aurelith Reserve connects directly to Firebase Authentication and Cloud Firestore.
# No external backend server or VITE_API_URL is required for authentication or static hosting on Netlify.
